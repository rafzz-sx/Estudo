# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o modelo. Ele so tem marcador de posicao, nenhum valor real, e
# e o arquivo que o README manda copiar no primeiro passo:
#   cp apps/web/.env.example apps/web/.env.local
# Sem esta excecao, esse passo era impossivel a partir de um clone limpo —
# o modelo existia so na maquina de quem o escreveu.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
