# ============================================================
# BatCaverna — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# Supabase (Banco de dados relacional e Service Role)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT (Chave secreta forte — ex: openssl rand -hex 32)
JWT_SECRET=sua_chave_secreta_jwt_aqui
JWT_ACCESS_EXPIRATION=36000        # 10 horas em segundos
JWT_REFRESH_EXPIRATION=36000       # 10 horas em segundos

# ─── SERVIÇO DE E-MAIL (RECOMENDADO: SMTP GMAIL GRATUITO) ───
# Como configurar o Gmail:
# 1. Acesse https://myaccount.google.com/security
# 2. Ative a "Verificação em duas etapas"
# 3. Pesquise por "Senhas de app" (App Passwords)
# 4. Crie uma senha chamada "BatCaverna" (gerará 16 letras, ex: abcd efgh ijkl mnop)
# 5. Cole os dados abaixo:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=batcaverna.suporte@gmail.com
SMTP_PASS=sua_senha_de_app_do_google_16_letras
SMTP_FROM="BatCaverna <batcaverna.suporte@gmail.com>"

# Provedores Alternativos de E-mail (Opcional caso não use SMTP):
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@seu-dominio.com
# BREVO_API_KEY=xkeysib-...

# Redis (Upstash) — opcional para rate limiting distribuído
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Aplicação
NEXT_PUBLIC_APP_URL=https://batcaverna.app
NODE_ENV=development
