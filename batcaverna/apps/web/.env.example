# ============================================================
# BatCaverna — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT (gere uma chave secreta forte — ex: openssl rand -hex 32)
JWT_SECRET=sua_chave_secreta_jwt_aqui
JWT_ACCESS_EXPIRATION=900        # 15 minutos em segundos
JWT_REFRESH_EXPIRATION=36000     # 10 horas em segundos

# E-mail (Resend) — sem isto, o aluno nao consegue redefinir a senha sozinho.
# Veja o passo a passo na PARTE 9, acao A-6 do INSTRUCOES-DEPLOY.txt.
# Sem RESEND_API_KEY a tela avisa que a recuperacao nao esta ativa e manda
# para /contato — nao finge que enviou.
RESEND_API_KEY=re_...
# Precisa ser de um dominio verificado no Resend. Aceita
# "nome@dominio" ou "Nome <nome@dominio>". Em branco, usa o remetente de
# teste do Resend, que so entrega para o dono da conta.
EMAIL_FROM=noreply@batcaverna.com.br

# Redis (Upstash) — para rate limiting e cache de ranking
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
